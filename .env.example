# ==========================================
# STAGELINK - CONFIGURATION DE DÉPLOIEMENT
# ==========================================

# Base de données PostgreSQL (locale ou Neon / Supabase)
DATABASE_URL="postgresql://stagelink:stagelink_secure_password_2026@localhost:5432/stagelink?schema=public"

# Clé secrète NextAuth (générer avec: openssl rand -base64 32).
# Cette valeur doit rester stable entre les déploiements.
AUTH_SECRET="your-super-secret-random-key-at-least-32-chars-long"

# URL publique de la plateforme (frontend), utilisée par NextAuth pour les
# redirections et les cookies. Ne pas utiliser l'URL interne du conteneur.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# URL interne du backend (utilisée par le proxy frontend)
BACKEND_URL="http://localhost:3001"

# Paramètres métier plateforme
PAYMENT_PROVIDER="MOCK"
PLATFORM_COMMISSION_RATE="8"
AUTO_RELEASE_DAYS="7"

# Google OAuth (optionnel)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
