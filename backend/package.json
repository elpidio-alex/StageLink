{
  "name": "stagelink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts",
    "db:bootstrap-platform": "tsx prisma/bootstrap-admin.ts",
    "db:bootstrap-demo": "tsx prisma/bootstrap-demo.ts",
    "start:production": "npm run db:deploy && npm run db:bootstrap-platform && npm run db:bootstrap-demo && npm run start",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.80.7",
    "bcryptjs": "^3.0.2",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.29",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.60.2",
    "zod": "^3.25.76",
    "prisma": "^6.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
