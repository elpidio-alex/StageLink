    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.19.0",
    "@stagelink/shared": "file:../shared",
    "@tanstack/react-query": "^5.80.7",
    "bcryptjs": "^3.0.2",
    "next": "15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.60.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
