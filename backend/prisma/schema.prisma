generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  COMPANY
  MEDIATOR
  ADMIN
}

enum MissionStatus {
  DRAFT
  PUBLISHED
  ASSIGNED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  PENDING_PAYMENT
  ACTIVE
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum DeliverableStatus {
  SUBMITTED
  ACCEPTED
  REVISION_REQUESTED
}

enum LedgerEntryType {
  DEPOSIT
  ESCROW_HOLD
  ESCROW_RELEASE
  REFUND
  COMMISSION
  DISPUTE_PAYOUT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum StudentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  name                 String
  passwordHash         String?
  role                 Role
  phone                String?
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  studentProfile       StudentProfile?
  companyProfile       CompanyProfile?
  missions             Mission[]
  applications         Application[]
  contractsAsStudent   Contract[]      @relation("studentContracts")
  contractsAsCompany   Contract[]      @relation("companyContracts")
  messages             Message[]
  wallets              Wallet[]
  ledgerEntries        LedgerEntry[]
  disputesOpened       Dispute[]       @relation("openedDisputes")
  disputesResolved     Dispute[]       @relation("resolvedDisputes")
  reviewsGiven         Review[]        @relation("reviewsGiven")
  reviewsReceived      Review[]        @relation("reviewsReceived")
  notifications        Notification[]
  accounts             Account[]
  sessions             Session[]
  certificates         Certificate[]
  badges               Badge[]
}

model StudentProfile {
  id           String         @id @default(cuid())
  userId       String         @unique
  school       String
  field        String
  level        String
  bio          String?
  skills       String[]
  city         String
  hourlyRate   Int?
  studentProofPath String?
  studentProofStatus StudentProofStatus @default(PENDING)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability Availability[]
}

model Availability {
  id          String         @id @default(cuid())
  studentId   String
  dayOfWeek   Int
  startHour   Int
  endHour     Int
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId, dayOfWeek])
}

model CompanyProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  legalName   String
  description String?
  city        String
  sector      String
  verified    Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  missions    Mission[]
}

model Mission {
  id             String          @id @default(cuid())
  companyId      String
  categoryId     String
  title          String
  description    String
  city           String
  requiredSkills String[]
  estimatedHours Int
  budget         Int
  status         MissionStatus   @default(DRAFT)
  publishedAt    DateTime?
  deadline       DateTime
  createdAt      DateTime        @default(now())
  company        User            @relation(fields: [companyId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  applications   Application[]
  contract       Contract?
  @@index([status, city])
}

model Application {
  id          String            @id @default(cuid())
  missionId   String
  studentId   String
  coverLetter String
  matchScore  Int
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  mission     Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  student     User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([missionId, studentId])
}

model Contract {
  id            String         @id @default(cuid())
  missionId     String         @unique
  studentId     String
  companyId     String
  amount        Int
  status        ContractStatus @default(PENDING_PAYMENT)
  autoReleaseAt DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  mission       Mission        @relation(fields: [missionId], references: [id])
  student       User           @relation("studentContracts", fields: [studentId], references: [id])
  company       User           @relation("companyContracts", fields: [companyId], references: [id])
  deliverables  Deliverable[]
  messages      Message[]
  ledgerEntries LedgerEntry[]
  payments      Payment[]
  disputes      Dispute[]
  reviews       Review[]
  certificate   Certificate?
}

model Deliverable {
  id          String            @id @default(cuid())
  contractId  String
  title       String
  description String
  url         String?
  status      DeliverableStatus  @default(SUBMITTED)
  submittedAt DateTime          @default(now())
  reviewedAt  DateTime?
  contract    Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  contractId String
  senderId   String
  body       String
  createdAt  DateTime @default(now())
  readAt     DateTime?
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])
}

model Wallet {
  id        String        @id @default(cuid())
  userId    String        @unique
  currency  String        @default("XOF")
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]
}

model LedgerEntry {
  id           String          @id @default(cuid())
  walletId     String
  userId       String
  contractId   String?
  type         LedgerEntryType
  direction    LedgerDirection
  amount       Int
  reference    String          @unique
  description  String?
  createdAt    DateTime        @default(now())
  wallet       Wallet          @relation(fields: [walletId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  contract     Contract?       @relation(fields: [contractId], references: [id])
  @@index([walletId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  contractId    String
  provider      String
  providerRef   String?       @unique
  amount        Int
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contract      Contract      @relation(fields: [contractId], references: [id])
}

model Dispute {
  id           String        @id @default(cuid())
  contractId   String
  openedById   String
  resolvedById String?
  reason       String
  studentShare Int?
  decisionNote String?
  status       DisputeStatus @default(OPEN)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  contract     Contract      @relation(fields: [contractId], references: [id])
  openedBy     User          @relation("openedDisputes", fields: [openedById], references: [id])
  resolvedBy   User?         @relation("resolvedDisputes", fields: [resolvedById], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  contractId  String
  authorId    String
  recipientId String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  contract    Contract @relation(fields: [contractId], references: [id])
  author      User     @relation("reviewsGiven", fields: [authorId], references: [id])
  recipient   User     @relation("reviewsReceived", fields: [recipientId], references: [id])
  @@unique([contractId, authorId])
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  contractId String   @unique
  serial     String   @unique
  title      String
  issuedAt   DateTime @default(now())
  verifyUrl  String
  pdfUrl     String?
  user       User     @relation(fields: [userId], references: [id])
  contract   Contract @relation(fields: [contractId], references: [id])
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  awardedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, name])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
