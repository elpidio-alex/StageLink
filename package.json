{
  "name": "stagelink-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "typecheck:backend": "npm run typecheck --prefix backend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "test:backend": "npm run test --prefix backend",
    "test": "npm run test:backend",
    "db:generate": "npm run db:generate --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:deploy": "npm run db:deploy --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run start --prefix frontend"
  }
}